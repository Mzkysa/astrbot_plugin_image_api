{
  "provider": {
    "description": "接口类型",
    "type": "string",
    "options": ["openai", "sdwebui", "custom"],
    "labels": [
      "OpenAI 兼容接口（大多数中转站 / 云厂商）",
      "Stable Diffusion WebUI（本地或远程）",
      "自定义 HTTP 接口"
    ],
    "subtitles": [
      "POST /v1/images/generations，DALL·E、硅基流动、智谱、302.AI、NewAPI 等均属此类",
      "POST /sdapi/v1/txt2img，需要开启 --api 启动参数",
      "自己拼请求体、自己取图片字段，适合任意三方接口"
    ],
    "default": "openai",
    "hint": "先确认你的服务商提供的是哪种接口，再填写下面的参数。"
  },
  "api_base": {
    "description": "OpenAI 兼容接口地址",
    "type": "string",
    "default": "https://api.openai.com/v1",
    "hint": "Base URL，需要包含 /v1。也可以直接填完整的 …/v1/images/generations 地址。"
  },
  "api_key": {
    "description": "API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true
  },
  "auth_mode": {
    "description": "鉴权方式",
    "type": "string",
    "options": ["bearer", "api-key", "none"],
    "labels": ["Authorization: Bearer", "自定义请求头", "不鉴权"],
    "default": "bearer"
  },
  "api_key_header": {
    "description": "自定义鉴权请求头名称",
    "type": "string",
    "default": "X-API-Key",
    "hint": "仅当鉴权方式选择「自定义请求头」时生效。"
  },
  "model": {
    "description": "模型名称",
    "type": "string",
    "default": "gpt-image-1",
    "hint": "例如 gpt-image-1、dall-e-3、Kwai-Kolors/Kolors、cogview-4、flux-schnell 等，以服务商文档为准。"
  },
  "size": {
    "description": "默认图片尺寸",
    "type": "string",
    "default": "1024x1024",
    "hint": "格式为 宽x高，例如 1024x1024、1024x1792。SD WebUI 可以随意填写。"
  },
  "default_n": {
    "description": "默认生成张数",
    "type": "int",
    "default": 1,
    "slider": {"min": 1, "max": 4, "step": 1}
  },
  "max_n": {
    "description": "单次最多生成张数",
    "type": "int",
    "default": 4,
    "slider": {"min": 1, "max": 10, "step": 1},
    "hint": "用户通过 --n 指定张数时的上限。"
  },
  "response_format": {
    "description": "返回格式参数",
    "type": "string",
    "options": ["auto", "url", "b64_json"],
    "labels": ["自动（不发送该参数）", "url", "b64_json"],
    "default": "auto",
    "hint": "部分接口（如 gpt-image-1）不接受该参数，保持「自动」即可。"
  },
  "quality": {
    "description": "画质参数（可选）",
    "type": "string",
    "default": "",
    "hint": "例如 standard、hd、high、medium、low。留空则不发送该参数。"
  },
  "extra_headers": {
    "description": "额外的请求头",
    "type": "dict",
    "default": {},
    "items": {},
    "hint": "例如 {\"X-Foo\": \"bar\"}，会合并进每一次请求。"
  },
  "extra_body": {
    "description": "额外的请求体参数",
    "type": "dict",
    "default": {},
    "items": {},
    "hint": "会合并进 OpenAI 兼容接口的请求体，例如 {\"seed\": 42}。"
  },
  "timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 180,
    "slider": {"min": 10, "max": 600, "step": 10}
  },
  "retry": {
    "description": "网络失败重试次数",
    "type": "int",
    "default": 1,
    "slider": {"min": 0, "max": 3, "step": 1}
  },
  "max_concurrency": {
    "description": "最大并发生成数",
    "type": "int",
    "default": 2,
    "slider": {"min": 1, "max": 8, "step": 1},
    "hint": "同时进行的生成请求上限，适当调低可以避免触发服务商限流。"
  },
  "cooldown_seconds": {
    "description": "单用户冷却时间（秒）",
    "type": "int",
    "default": 10,
    "slider": {"min": 0, "max": 120, "step": 5},
    "hint": "设为 0 表示不限制。"
  },
  "max_prompt_length": {
    "description": "提示词长度上限（字）",
    "type": "int",
    "default": 800,
    "slider": {"min": 50, "max": 4000, "step": 50}
  },
  "notify_before_generate": {
    "description": "生成前发送提示消息",
    "type": "bool",
    "default": true
  },
  "keep_days": {
    "description": "生成图片保留天数",
    "type": "int",
    "default": 7,
    "slider": {"min": 0, "max": 30, "step": 1},
    "hint": "0 表示永久保留。图片存放在 data/plugin_data/astrbot_plugin_image_api/images。"
  },
  "enable_llm_tool": {
    "description": "启用大模型工具 generate_image",
    "type": "bool",
    "default": true,
    "hint": "启用后，大模型可以在对话中自动调用本插件生成图片（需开启函数调用能力）。"
  },
  "sd_base_url": {
    "description": "SD WebUI 地址",
    "type": "string",
    "default": "http://127.0.0.1:7860",
    "hint": "启动参数需要包含 --api，例如 ./webui.sh --api --listen。"
  },
  "sd_negative_prompt": {
    "description": "SD 默认负面提示词",
    "type": "text",
    "default": "lowres, bad anatomy, bad hands, worst quality, low quality, jpeg artifacts, watermark, signature"
  },
  "sd_steps": {
    "description": "SD 采样步数",
    "type": "int",
    "default": 25,
    "slider": {"min": 5, "max": 80, "step": 1}
  },
  "sd_cfg_scale": {
    "description": "SD 提示词引导系数",
    "type": "float",
    "default": 7.0,
    "slider": {"min": 1.0, "max": 20.0, "step": 0.5}
  },
  "sd_sampler": {
    "description": "SD 采样器",
    "type": "string",
    "default": "DPM++ 2M Karras"
  },
  "custom_url": {
    "description": "自定义接口地址",
    "type": "string",
    "default": "",
    "hint": "支持占位符：{prompt}、{negative_prompt}、{size}、{width}、{height}、{n}、{model}、{seed}，例如 https://api.example.com/v1/gen?q={prompt}"
  },
  "custom_method": {
    "description": "自定义接口请求方法",
    "type": "string",
    "options": ["POST", "GET"],
    "default": "POST"
  },
  "custom_body": {
    "description": "自定义请求体模板",
    "type": "text",
    "default": "{\"prompt\": \"{prompt}\", \"n\": {n}}",
    "editor_mode": true,
    "editor_language": "json",
    "hint": "JSON 文本，可用与地址相同的占位符；GET 请求时会把它变成查询参数。"
  },
  "custom_image_path": {
    "description": "图片字段路径",
    "type": "string",
    "default": "",
    "hint": "例如 data.0.url、images.0、result.image_url；留空则自动在响应中查找第一张图片。"
  }
}
